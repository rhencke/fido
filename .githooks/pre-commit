#!/bin/sh
# Pre-commit — verify the PROPOSED COMMIT (the Git index) and nothing else.  It exports the index EXACTLY
# ONCE and, from that point on, treats the exported staged snapshot as the AUTHORITATIVE source tree for
# every gate implementation AND every source byte — so a staged bad gate script or staged bad OCaml boundary
# is the version evaluated, not the (possibly safe) working-tree copy.  It runs on EVERY ordinary commit
# (no conditional "relevant input" list; Buildx caching is the only optimization), and it never mutates the
# working tree, alters the index, or runs `git add`.  PROTOTYPE boundary: `git commit --no-verify` bypasses
# it (a future PR CI runs the same staged/generated comparison server-side); do not remove that honest limit.
set -e

command -v docker >/dev/null 2>&1 || { echo "fido: pre-commit needs docker for the pinned staged-index verification"; exit 1; }
FIDO_BUILDER=fido-builder

# (0) COMPLETE-PATH TIMER (§5): it starts BEFORE any Docker/builder setup, index export, pinned-image build,
#     policy gate, or verification stage — the whole required staged path is the measured subject, through the
#     same one budget owner/runner as `make check` (tools/check-budget.sh).  FIDO_CHECK_TEST_SLEEP is a
#     test-only pre-setup delay used by the budget adversaries; unset in production it does nothing.
t0=$(date +%s)
[ -z "$FIDO_CHECK_TEST_SLEEP" ] || sleep "$FIDO_CHECK_TEST_SLEEP"
docker buildx inspect "$FIDO_BUILDER" >/dev/null 2>&1 || docker buildx create --name "$FIDO_BUILDER" --driver docker-container --bootstrap >/dev/null

# (1) export the Git INDEX exactly once into a temp dir; this exported tree is the proposed commit and needs
#     no .git to inspect source contents.  --ignore-skip-worktree-bits is MANDATORY: `--all` alone silently
#     omits index entries carrying the skip-worktree bit.  The export and builder are timed once; the warmed
#     confirmation reuses this immutable snapshot and the acquired images/builders.
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
ctx="$tmp/context"
git checkout-index --ignore-skip-worktree-bits --all --prefix="$ctx/"

# staged_all — every required staged gate and verification of the proposed commit, over the immutable $ctx.
# It re-runs whole on the warmed confirmation (reusing $ctx and acquired images).  Every fallible step carries
# `|| return $?` so a producer failure is returned as itself and never masked by the budget.
staged_all() {
  # (1a) build the pinned Python image FROM THE STAGED CONTEXT; run every Python gate inside it (host stays clean).
  pytag="fido-python-tools:$(cat "$ctx/Dockerfile" "$ctx/tools/python-requirements.lock" | sha256sum | cut -c1-16)"
  docker image inspect "$pytag" >/dev/null 2>&1 || \
    docker buildx build --builder "$FIDO_BUILDER" --platform linux/amd64 --target python-tools --load -t "$pytag" "$ctx" >/dev/null || return $?
  fido_py() {
    docker run --rm -u "$(id -u):$(id -g)" -e PYTHONDONTWRITEBYTECODE=1 -e HOME=/tmp \
      -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e GIT_CONFIG_VALUE_0=/repo \
      -w /repo -v "$ctx":/repo:ro "$pytag" python3 "$@"
  }
  # (2) staged copies of the lightweight repository-policy gates on the exported staged tree.
  sh "$ctx/tools/ocaml-origin-gate.sh"    "$ctx" || return $?
  sh "$ctx/tools/generated-output-gate.sh" "$ctx" || return $?
  sh "$ctx/tools/generated-mode-gate.sh" || return $?          # reads the repo index for exact Git mode
  fido_py tools/gate-mutation-test.py --root /repo || return $?
  fido_py tools/source-diet.py --root /repo --snapshot --self-test || return $?
  fido_py tools/source-diet.py --root /repo --snapshot --check || return $?
  fido_py tools/host-python-gate.py --root /repo --self-test || return $?
  fido_py tools/host-python-gate.py --root /repo || return $?
  # (2a2) staged performance-evidence currentness: the digest of the exact STAGED INDEX, the committed HEAD
  #       digest, and whether the proposed commit itself changes the evidence files — all fed to the STAGED
  #       validator over the STAGED evidence bytes and the STAGED digest algorithm.  Malformed evidence, an
  #       incomplete required row, missing final-candidate coverage, or newly published rows bound to any
  #       basis but the staged one fail HERE, before proof/e2e publication.  No benchmark runs in the hook.
  pd=$(sh "$ctx/tools/performance-input-digest.sh") || return $?
  ph=$(sh "$ctx/tools/performance-input-digest.sh" --head) || return $?
  pec=$(git diff --cached --quiet -- .review/PERFORMANCE.tsv && echo no || echo yes)
  fido_py tools/build-graph-gate.py --self-test || return $?
  fido_py tools/build-graph-gate.py --root /repo || return $?
  fido_py tools/perf-evidence-validate.py --self-test || return $?
  fido_py tools/perf-evidence-validate.py --digest "$pd" --head-digest "$ph" --evidence-changed "$pec" || return $?
  # (2b) BUDGET-EDGE integrity (§7.5): one owner in check-budget.sh (no Make variable), and both make check and
  #      this hook route through it; the make check recipe times the complete path (no heavy prereq before t0).
  grep -qF 'BUDGET_SECONDS=120' "$ctx/tools/check-budget.sh" || { echo "fido: pre-commit — the one budget owner BUDGET_SECONDS=120 is missing from tools/check-budget.sh"; return 1; }
  if grep -qF 'CHECK_BUDGET_SECONDS' "$ctx/Makefile"; then echo "fido: pre-commit — a CHECK_BUDGET_SECONDS Make variable would be an overridable second budget owner"; return 1; fi
  grep -qF 'check-budget.sh $$dt' "$ctx/Makefile" || { echo "fido: pre-commit — make check no longer routes through the budget runner"; return 1; }
  grep -qE '^check:[[:space:]]*$' "$ctx/Makefile" || { echo "fido: pre-commit — make check must carry no heavy prerequisite before its t0 timer (complete-path timing)"; return 1; }
  grep -qF 'check-budget.sh" "$dt"' "$ctx/.githooks/pre-commit" || { echo "fido: pre-commit — the staged hook no longer routes through the budget runner"; return 1; }
  grep -qE 't0=\$\(date \+%s\)' "$ctx/.githooks/pre-commit" || { echo "fido: pre-commit — the staged hook no longer starts its complete-path timer"; return 1; }
  echo "fido: pre-commit — budget-edge integrity OK — one owner; make check + this hook both route through it; both time the complete path"
  sh "$ctx/tools/check-budget.sh" --self-test || return $?
  # (3) the complete staged verification: ONE verified BuildKit DAG (the staged helper against the staged
  #     context/Dockerfile) performs proof, emit, Go, and artifact production — the final target requires both
  #     the proof-audit and fresh-build markers, so a failed branch fails this one solve.
  rm -rf "$tmp/pristine"
  sh "$ctx/tools/build-verified-artifact.sh" --builder "$FIDO_BUILDER" --platform linux/amd64 \
    ${FIDO_PERF_COLD:+--project-cold} --context "$ctx" --output "$tmp/pristine" || return $?
  # (4) byte-compare the STAGED generated sources against the exact exported pristine artifact.
  sh "$ctx/tools/staged-generated-compare.sh" "$ctx" "$tmp/pristine" || return $?
}

bud=$(sh "$ctx/tools/check-budget.sh" --budget)
echo "fido: pre-commit — verifying the STAGED tree (budget-enforced ${bud}s, complete path: setup + policy gates + proof + go build + staged==pristine bytes)..."
rc=0; staged_all || rc=$?; dt=$(( $(date +%s) - t0 ))
[ "$rc" -eq 0 ] || exit "$rc"
echo "fido: pre-commit — complete staged path ${dt}s (budget ${bud}s)"
if ! sh "$ctx/tools/check-budget.sh" "$dt"; then
  echo "fido: pre-commit — first pass ${dt}s over budget; ONE warmed confirmation follows (reuses the exported snapshot and acquired images)"
  t1=$(date +%s); rc=0; staged_all || rc=$?; dt2=$(( $(date +%s) - t1 ))
  [ "$rc" -eq 0 ] || exit "$rc"
  echo "fido: pre-commit — warmed confirmation ${dt2}s (budget ${bud}s)"
  sh "$ctx/tools/check-budget.sh" "$dt2"
fi

echo "fido: pre-commit OK — the complete budget-enforced staged verification (setup + staged gates + proof gate + whole-tree go build + staged==pristine generated bytes) ran against the exported Git index (bypass with --no-verify — a documented prototype-stage escape)."
