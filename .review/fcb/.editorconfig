# Fido Conformance Basis — byte rules for the living documentation corpus.
#
# Nested under the repository root config, which supplies charset, line endings and the rest.  `root` is
# deliberately NOT set here so those defaults still apply; this file overrides only what the documents need.
# It lives with the corpus so the rules travel with it when the tree is zipped, extracted, or moved.

[*]
# Trailing spaces in these documents are Markdown HARD LINE BREAKS carrying the banner layout.  Stripping them
# silently reflows the governing documents, so no editor may trim them.  (Per accepted amendment A003 this
# corpus is living documentation with no checksum manifest — Git content-addresses every byte — so the reason
# to leave them alone is semantic, not a hash.)
trim_trailing_whitespace = false
insert_final_newline = false

[*.{tsv,csv}]
# The ledgers are canonical tabular data: a trailing tab is a MEANINGFUL empty final field, never padding.
indent_style = tab
trim_trailing_whitespace = false
