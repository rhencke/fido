Definition e_expr_is_unary : Index.node_view (Index.Edges.ee_child e_expr) = Index.Model.VUnary Syntax.UnaryMinus
  := ltac:(vm_compute; reflexivity).
Definition e_main : Index.Refs.MainOccurrenceRef eidx :=
