Definition e_body := Index.Edges.main_body e_main.
Definition e_body_block : Index.Refs.BlockRef eidx := Index.Edges.mb_body e_body.
Definition e_cs1 : Index.Refs.SpecRef eidx Index.Model.ConstSpecF :=
