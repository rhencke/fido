# Fido — editor conventions.
#
# This file exists mostly to PROTECT bytes, not to reformat them.  Large parts of this repository are
# byte-exact by construction: generated Go that is byte-compared against a
# pristine build, and reviewed goldens that pin control characters.  An editor that helpfully strips a trailing
# space or adds a final newline in those trees breaks a proof gate, the generated-byte compare, or the meaning
# of a document.
# Every `= false` below is load-bearing; do not "tidy" it away.
#
# Measured state when this file was added (141 tracked files): no CRLF anywhere, every file ends with a
# newline, and the ONLY trailing whitespace lives in the two documentation trees called out below, where it is
# Markdown hard line breaks and meaningful empty TSV fields.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ---- tab-significant ----

# Make recipes REQUIRE hard tabs.  Converting them to spaces breaks the build outright.
[Makefile]
indent_style = tab

# ---- generated output: never hand-edited, byte-compared against the pristine Buildx layer ----

# The tracked canonical module (root go.mod + recursive .go) is a REVIEWED DERIVED ARTIFACT.  Its bytes come
# from GoRender and must byte-match a pristine build (`make check`, and the staged pre-commit compare).  Any
# editor-side whitespace change is a build failure.  Go itself is gofmt-shaped: hard tabs.
[*.go]
indent_style = tab
trim_trailing_whitespace = false
insert_final_newline = false

[go.mod]
trim_trailing_whitespace = false
insert_final_newline = false

# ---- documentation trees carry their own nested .editorconfig ----
#
# EditorConfig nests, so the byte rules for a documentation corpus live WITH that corpus rather than being
# described from up here:
#   .review/fcb/.editorconfig                    — the living Fido Conformance Basis
#   .review/spec-closure-campaign/.editorconfig  — the frozen spec-closure campaign record
# Neither sets `root`, so both inherit the defaults above and override only what they must.  Keeping them local
# means the rules travel with the documents when the tree is zipped, extracted, or moved.

# ---- reviewed goldens: exact observed program bytes ----

# The e2e goldens pin stdout/stderr/exit of the emitted witness, including tabs, CR, and other control
# characters.  Normalizing them would corrupt the very thing they exist to pin.
[e2e/golden.*]
trim_trailing_whitespace = false
insert_final_newline = false

# ---- tabular data: a trailing tab is a MEANINGFUL empty final field ----

# e.g. PROBE_ENVIRONMENT.tsv pins `GOFLAGS` and `GODEBUG` to the EMPTY value as a trailing tab.  Trimming it
# deletes the field.
[*.{tsv,csv}]
indent_style = tab
trim_trailing_whitespace = false

# ---- sources ----

# Rocq theory, OCaml transport boundary, shell gates: spaces, width 2 (measured dominant convention).
[*.{v,ml,mli,mlg,sh}]
indent_style = space
indent_size = 2

# Markdown: two trailing spaces are a hard line break, so trimming is unsafe as a blanket rule; the prose in
# this repo does not rely on it outside the documentation trees above, but keep the width convention explicit.
[*.md]
indent_size = 2
